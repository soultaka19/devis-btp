{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/api/:chemin*",
      "destination": "https://devis-api.soultaka.com/:chemin*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
