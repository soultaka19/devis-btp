# Copier ce fichier en .env.prod et remplir les valeurs
# cp .env.prod.example .env.prod

# Base de donnees
DB_PASSWORD=un-mot-de-passe-fort-ici

# Application
SECRET_KEY=une-cle-secrete-longue-et-aleatoire

# OpenAI (parsing IA des devis)
OPENAI_API_KEY=sk-votre-cle-openai

# Email (optionnel)
RESEND_API_KEY=re_votre-cle-resend
RESEND_FROM_EMAIL=devis@votre-domaine.com

# Domaine (laisser vide ou localhost pour IP uniquement, Caddy gerera HTTPS automatiquement quand un domaine est configure)
DOMAIN=localhost
