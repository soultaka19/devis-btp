# Copier ce fichier en .env.prod et remplir les valeurs
# cp .env.prod.example .env.prod
# DB_PASSWORD et SECRET_KEY sont obligatoires : docker compose refuse de demarrer sans eux.

# Base de donnees (generer avec : openssl rand -hex 32)
DB_PASSWORD=un-mot-de-passe-fort-ici

# Application
# APP_ENV=production est fixe dans docker-compose.prod.yml : l'API refuse de demarrer
# si SECRET_KEY est vide, trop courte (< 32 caracteres) ou une valeur d'exemple.
# Generer avec : openssl rand -hex 32
SECRET_KEY=une-cle-secrete-longue-et-aleatoire

# OpenAI (parsing IA des devis)
LLM_API_KEY=votre-cle-google-gemini
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

# Email (optionnel)
RESEND_API_KEY=re_votre-cle-resend
RESEND_FROM_EMAIL=devis@votre-domaine.com

# Domaine — pour acces par IP uniquement, utiliser :80
# Avec Cloudflare proxy : utiliser le domaine sans https://
DOMAIN=devis-btp.soultaka.com

# CORS — origines autorisees (JSON array)
CORS_ORIGINS=["https://devis-btp.soultaka.com","http://devis-btp.soultaka.com"]
