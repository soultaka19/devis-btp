# Environment: development (default) or production.
# In production the API refuses to start with an empty, short (< 32 chars) or example SECRET_KEY.
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devis_btp

# JWT (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-...

# Storage (local filesystem, served by the API under /uploads)
STORAGE_LOCAL_PATH=./uploads

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=devis@example.com

# CORS
CORS_ORIGINS=["http://localhost:4200"]
