# Environment: development (default) or production.
# In production the API refuses to start with an empty, short (< 32 chars) or example SECRET_KEY.
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devis_btp

# JWT (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM provider — any endpoint exposing the OpenAI API works.
# Default: Google Gemini through its OpenAI-compatible layer.
# Key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Used for BOTH text parsing (function calling) and voice transcription:
# Google exposes no /audio/transcriptions endpoint (verified: 404), so audio is
# sent inline to chat/completions. gemini-2.5-flash answers 404 "no longer
# available to new users" — stay on the 3.x generation.
LLM_MODEL=gemini-3.6-flash

# Deprecated, kept for backward compatibility: used only when LLM_API_KEY is empty.
# OPENAI_API_KEY=

# Storage (local filesystem, served by the API under /uploads)
STORAGE_LOCAL_PATH=./uploads

# Email (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=devis@example.com

# CORS
CORS_ORIGINS=["http://localhost:4200"]
